modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "keepsake-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "keepsake-cloud"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "keepsake-typecheck"

[[workflows.workflow]]
name = "keepsake-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/kids-voice-encyclopedia run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "keepsake-cloud"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/kids-voice-encyclopedia run test:cloud"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "keepsake-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/kids-voice-encyclopedia run typecheck"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["jdk21_headless"]
